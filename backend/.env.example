MONGODB_URI=mongodb://localhost:27017/qa-tracker
JWT_SECRET=cambia-este-valor-por-un-secreto-largo-y-aleatorio
JWT_EXPIRES_IN=8h
UPLOADS_PATH=./uploads
PORT=4000
MAX_IMAGE_MB=10
MAX_VIDEO_MB=100
# Google Chat reescribe a https los links de los botones de sus cards (ver CLAUDE.md,
# sección de webhooks) — en local, usá https://localhost:5173 (requiere que el frontend
# corra con @vitejs/plugin-basic-ssl, ya configurado en frontend/vite.config.js) para que el
# botón "Abrir HU" funcione al clickearlo desde Chat.
APP_BASE_URL=http://localhost:5173
